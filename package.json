{
  "name": "opencode-context-tui",
  "version": "0.1.0",
  "description": "Native OpenCode TUI modal for inspecting current-session context usage",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "author": "ZackarySantana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackarySantana/opencode-context.git"
  },
  "homepage": "https://github.com/ZackarySantana/opencode-context#readme",
  "bugs": {
    "url": "https://github.com/ZackarySantana/opencode-context/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": "^2.1.1"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "tokens",
    "tui"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.6.6 <1",
    "@opentui/solid": ">=0.6.6 <1",
    "solid-js": ">=1.9.10 <2"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.1"
  },
  "devDependencies": {
    "@opencode/client": "2.1.1",
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
